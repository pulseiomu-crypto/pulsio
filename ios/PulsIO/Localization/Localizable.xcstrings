    "onboarding.pulse.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pulse is a live snapshot of Mauritius — weather, power cuts, cyclone status, fuel, what's happening near you — in one tap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un pulse, c'est un instantané en direct de Maurice — météo, coupures, situation cyclonique, carburant, ce qui se passe près de vous — en un geste."
          }
        }
      }
    },
