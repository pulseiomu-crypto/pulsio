    "location.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où êtes-vous ?"
          }
        }
      }
    },
    "location.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your location, PulsIO works out which district you're in and shows the power cuts, water cuts, weather and alerts that matter to you — and the nearest shelter if a cyclone comes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avec votre position, PulsIO détermine votre district et affiche les coupures d'électricité et d'eau, la météo et les alertes qui vous concernent — et l'abri le plus proche en cas de cyclone."
          }
        }
      }
    },
    "location.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your position never leaves this phone. Only your district — one of nine — is ever saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre position ne quitte jamais ce téléphone. Seul votre district — l'un des neuf — est enregistré."
          }
        }
      }
    },
    "location.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use my location"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utiliser ma position"
          }
        }
      }
    },
    "location.chooseInstead": {
      "extractionState": "manual",
